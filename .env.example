# --- Shared ---
COMPOSE_PROJECT_NAME=nas
PRIMARY_PARTITION=/srv/dev-disk-by-uuid-a
SECONDARY_PARTITION=/srv/dev-disk-by-uuid-b
DOMAIN=example.ro

# --- Plex ---
PLEX_CLAIM=

# --- go2rtc (restream for Agent DVR / HA / browsers) ---
GO2RTC_API_USERNAME=
GO2RTC_API_PASSWORD=
GO2RTC_RTSP_USERNAME=
GO2RTC_RTSP_PASSWORD=
FATA_URL=
SPATE_URL=
SOPRU_URL=
POD_URL=
TERASA_URL=
# Use each camera's MAIN / high-res RTSP URL.

# --- Duplicati ---
DUPLICATI_PASSWORD=
SETTINGS_ENCRYPTION_KEY=

# --- Immich ---
IMMICH_VERSION=release
IMMICH_UPLOAD_LOCATION=immich/library
IMMICH_DB_DATA_LOCATION=immich/postgres
IMMICH_TZ=Europe/Bucharest
IMMICH_DB_PASSWORD=
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_STORAGE_TYPE=HDD
IMMICH_ML_HWACCEL=openvino

# --- NUT (nJoy Code 800, UPLI-LI080CO-AZ01B) ---
# ViewPower USB → nutdrv_qx. Set a strong API password (12+ chars; no ", \, #).
NUT_UPS_DRIVER=nutdrv_qx
NUT_API_USER=monuser
NUT_API_PASSWORD=

# --- PeaNUT (NUT web UI on :8282) ---
PEANUT_WEB_USERNAME=admin
PEANUT_WEB_PASSWORD=
